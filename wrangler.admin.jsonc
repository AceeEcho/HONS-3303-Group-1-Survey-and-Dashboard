{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dashboard-hons3303survey",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "account_id": "d45bcd1285e74f348c5d99ce0401fe9e",
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_MODE": "admin",
    "ENVIRONMENT": "production",
    "AUTH_MODE": "shared-password",
    "PUBLIC_SURVEY_URL": "https://survey-hons3303survey.echowake.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hons3303survey",
      "database_id": "429c0ed8-c256-47d2-b6d9-27cb9059867a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "3303304",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
