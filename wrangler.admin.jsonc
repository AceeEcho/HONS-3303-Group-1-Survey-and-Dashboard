{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fieldwork-studio", "main": "src/worker.js", "compatibility_date": "2026-09-01", "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true},
  "vars": {"APP_MODE": "admin", "ENVIRONMENT": "production", "ACCESS_TEAM_DOMAIN":"REPLACE.cloudflareaccess.com", "ACCESS_AUD":"REPLACE_WITH_ACCESS_AUD", "ADMIN_EMAILS":"", "PUBLIC_SURVEY_URL":"https://REPLACE.workers.dev"},
  "d1_databases": [{"binding":"DB","database_name":"fieldwork","database_id":"REPLACE_WITH_D1_ID","migrations_dir":"migrations"}],
  "observability": {"enabled":false}
}
