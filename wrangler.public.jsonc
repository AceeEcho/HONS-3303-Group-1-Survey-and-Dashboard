{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fieldwork-survey", "main": "src/worker.js", "compatibility_date": "2026-09-01", "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true},
  "vars": {"APP_MODE": "public", "ENVIRONMENT": "production"},
  "d1_databases": [{"binding":"DB","database_name":"fieldwork","database_id":"REPLACE_WITH_D1_ID","migrations_dir":"migrations"}],
  "ratelimits": [{"name":"SUBMIT_LIMITER","namespace_id":"1001","simple":{"limit":10,"period":60}}],
  "observability": {"enabled":false}
}
